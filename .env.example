# ESPN Fantasy credentials — used by espn-mcp-server (and local tool runs).
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The real `.env` is NEVER committed and its secret values are never pasted
# into chat — create it locally.
#
#   cp .env.example .env   # then edit .env
#
# Non-secret:
ESPN_LEAGUE_ID=your_league_id
ESPN_SEASON=2026
#
# SECRET — ESPN session cookies. Paste ONLY the cookie VALUE (not "NAME=value").
# SWID is a GUID in braces: {8-4-4-4-12}.
ESPN_S2=paste_espn_s2_cookie_value
ESPN_SWID={your-swid-guid}
